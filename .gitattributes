# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Code and markup
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Windows scripts (require CRLF for native cmd/powershell execution)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.lnk binary
