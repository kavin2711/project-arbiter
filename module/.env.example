# Groq API Key (Recommended - ultra-fast LPUs, no 429 quota exhaustion)
# Get a free key instantly from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active Provider: 'groq' (default) or 'gemini'
ACTIVE_PROVIDER=groq

# Groq Vision Model (Active supported model on Groq)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Module Server Port
PORT=8000
HOST=0.0.0.0
